# Required external model locations
SIGNDUPLEX_MINICPM_DIR=/path/to/MiniCPM-o-4_5
SIGNDUPLEX_UNISIGN_DIR=/path/to/Uni-Sign

# SignDuplex weights and training inputs
SIGNDUPLEX_CHECKPOINT=checkpoints/signduplex_v1_8.pt
SIGNDUPLEX_WARM_START=checkpoints/warm_start.pth
SIGNDUPLEX_DATA_DIR=data/Sign_Aware_Raw_Screen_v1_8
SIGNDUPLEX_OUTPUT_DIR=outputs/train_v1_8

# Runtime
SIGNDUPLEX_DEVICE=cuda:0
SIGNDUPLEX_PHYSICAL_GPU=0
SIGNDUPLEX_HOST=0.0.0.0
SIGNDUPLEX_PORT=7863
